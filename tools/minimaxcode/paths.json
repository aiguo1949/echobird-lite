{
    "name": "MiniMax CLI",
    "category": "CLI Code",
    "apiProtocol": [
        "openai",
        "anthropic"
    ],
    "docs": "https://agent.minimax.io/docs/cli/quick-start",
    "website": "https://github.com/MiniMax-AI/minimax-code",
    "command": "mcode",
    "startCommand": "mcode",
    "envVar": "MCODE_PATH",
    "configDir": "~/.minimax",
    "configFile": "~/.minimax/config.yaml",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%USERPROFILE%\\.minimax-code\\mcode.cmd",
            "%APPDATA%\\npm\\mcode.cmd",
            "%LOCALAPPDATA%\\pnpm\\mcode.cmd"
        ],
        "darwin": [
            "~/.minimax-code/bin/mcode",
            "/usr/local/bin/mcode",
            "/opt/homebrew/bin/mcode",
            "~/.local/bin/mcode",
            "~/.npm-global/bin/mcode"
        ],
        "linux": [
            "~/.minimax-code/bin/mcode",
            "/usr/local/bin/mcode",
            "/usr/bin/mcode",
            "~/.local/bin/mcode",
            "~/.npm-global/bin/mcode"
        ]
    }
}
