{
    "name": "Cline CLI",
    "category": "CLI Code",
    "apiProtocol": ["openai", "anthropic"],
    "docs": "https://docs.cline.bot/cline-cli/overview",
    "website": "https://cline.bot/cli",
    "command": "cline",
    "startCommand": "cline",
    "envVar": "CLINE_PATH",
    "configDir": "~/.cline/data/settings",
    "configFile": "~/.cline/data/settings/providers.json",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%APPDATA%\\npm\\cline.cmd",
            "%LOCALAPPDATA%\\pnpm\\cline.cmd",
            "%USERPROFILE%\\.bun\\bin\\cline.exe"
        ],
        "darwin": [
            "/usr/local/bin/cline",
            "/opt/homebrew/bin/cline",
            "~/.local/bin/cline",
            "~/.npm-global/bin/cline",
            "~/.bun/bin/cline",
            "~/.local/share/pnpm/cline"
        ],
        "linux": [
            "/usr/local/bin/cline",
            "/usr/bin/cline",
            "~/.local/bin/cline",
            "~/.npm-global/bin/cline",
            "~/.bun/bin/cline",
            "~/.local/share/pnpm/cline"
        ]
    }
}
